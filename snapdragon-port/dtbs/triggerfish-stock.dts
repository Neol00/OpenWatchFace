/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Fossil Group, Inc. based on APQ8009W-PM660 BG Alpha SDW3100";
	compatible = "qcom,apq8009-mtp", "qcom,apq8009", "qcom,mtp";
	qcom,msm-id = <0x109 0x00 0x12d 0x00>;
	interrupt-parent = <0x01>;
	qcom,board-id = <0x08 0x15>;
	qcom,pmic-id = <0x1001b 0x00 0x00 0x00 0x1011b 0x00 0x00 0x00>;

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x00>;
			efficiency = <0x400>;
			sched-energy-costs = <0x06 0x07>;
			qcom,sleep-status = <0x08>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x01>;
			efficiency = <0x400>;
			sched-energy-costs = <0x06 0x07>;
			qcom,sleep-status = <0x09>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x03>;
			phandle = <0x03>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x02>;
			efficiency = <0x400>;
			sched-energy-costs = <0x06 0x07>;
			qcom,sleep-status = <0x0a>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x04>;
			phandle = <0x04>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x03>;
			efficiency = <0x400>;
			sched-energy-costs = <0x06 0x07>;
			qcom,sleep-status = <0x0b>;
			#cooling-cells = <0x02>;
			linux,phandle = <0x05>;
			phandle = <0x05>;
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";

		qcom,ion {
			compatible = "qcom,msm-ion";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qcom,ion-heap@25 {
				reg = <0x19>;
				qcom,ion-heap-type = "SYSTEM";
			};

			qcom,ion-heap@27 {
				reg = <0x1b>;
				memory-region = <0x0c>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@28 {
				reg = <0x1c>;
				memory-region = <0x0d>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@19 {
				reg = <0x13>;
				memory-region = <0x0e>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@22 {
				reg = <0x16>;
				memory-region = <0x0f>;
				qcom,ion-heap-type = "DMA";
			};
		};

		qcom,smp2p-modem {
			compatible = "qcom,smp2p";
			reg = <0xb011008 0x04>;
			qcom,remote-pid = <0x01>;
			qcom,irq-bitmask = <0x4000>;
			interrupts = <0x00 0x1b 0x01>;
		};

		qcom,smp2p-wcnss {
			compatible = "qcom,smp2p";
			reg = <0xb011008 0x04>;
			qcom,remote-pid = <0x04>;
			qcom,irq-bitmask = <0x40000>;
			interrupts = <0x00 0x8f 0x01>;
		};

		qcom,smp2pgpio-smp2p-15-in {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "smp2p";
			qcom,remote-pid = <0x0f>;
			qcom,is-inbound;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x10>;
			phandle = <0x10>;
		};

		qcom,smp2pgpio_test_smp2p_15_in {
			compatible = "qcom,smp2pgpio_test_smp2p_15_in";
			gpios = <0x10 0x00 0x00>;
		};

		qcom,smp2pgpio-smp2p-15-out {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "smp2p";
			qcom,remote-pid = <0x0f>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x11>;
			phandle = <0x11>;
		};

		qcom,smp2pgpio_test_smp2p_15_out {
			compatible = "qcom,smp2pgpio_test_smp2p_15_out";
			gpios = <0x11 0x00 0x00>;
		};

		qcom,smp2pgpio-smp2p-1-in {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "smp2p";
			qcom,remote-pid = <0x01>;
			qcom,is-inbound;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x12>;
			phandle = <0x12>;
		};

		qcom,smp2pgpio_test_smp2p_1_in {
			compatible = "qcom,smp2pgpio_test_smp2p_1_in";
			gpios = <0x12 0x00 0x00>;
		};

		qcom,smp2pgpio-smp2p-1-out {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "smp2p";
			qcom,remote-pid = <0x01>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x13>;
			phandle = <0x13>;
		};

		qcom,smp2pgpio_test_smp2p_1_out {
			compatible = "qcom,smp2pgpio_test_smp2p_1_out";
			gpios = <0x13 0x00 0x00>;
		};

		qcom,smp2pgpio-smp2p-4-in {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "smp2p";
			qcom,remote-pid = <0x04>;
			qcom,is-inbound;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x14>;
			phandle = <0x14>;
		};

		qcom,smp2pgpio_test_smp2p_4_in {
			compatible = "qcom,smp2pgpio_test_smp2p_4_in";
			gpios = <0x14 0x00 0x00>;
		};

		qcom,smp2pgpio-smp2p-4-out {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "smp2p";
			qcom,remote-pid = <0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x15>;
			phandle = <0x15>;
		};

		qcom,smp2pgpio_test_smp2p_4_out {
			compatible = "qcom,smp2pgpio_test_smp2p_4_out";
			gpios = <0x15 0x00 0x00>;
		};

		qcom,smp2pgpio-ssr-smp2p-4-in {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "slave-kernel";
			qcom,remote-pid = <0x04>;
			qcom,is-inbound;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0xfc>;
			phandle = <0xfc>;
		};

		qcom,smp2pgpio-ssr-smp2p-4-out {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "master-kernel";
			qcom,remote-pid = <0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0xfd>;
			phandle = <0xfd>;
		};

		qcom,smp2pgpio-ssr-smp2p-1-in {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "slave-kernel";
			qcom,remote-pid = <0x01>;
			qcom,is-inbound;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x100>;
			phandle = <0x100>;
		};

		qcom,smp2pgpio-ssr-smp2p-1-out {
			compatible = "qcom,smp2pgpio";
			qcom,entry-name = "master-kernel";
			qcom,remote-pid = <0x01>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0x101>;
			phandle = <0x101>;
		};

		qcom,ipc_router {
			compatible = "qcom,ipc_router";
			qcom,node-id = <0x01>;
		};

		qcom,ipc_router_modem_xprt {
			compatible = "qcom,ipc_router_smd_xprt";
			qcom,ch-name = "IPCRTR";
			qcom,xprt-remote = "modem";
			qcom,xprt-linkid = <0x01>;
			qcom,xprt-version = <0x01>;
			qcom,fragmented-data;
			qcom,disable-pil-loading;
		};

		qcom,ipc_router_wcnss_xprt {
			compatible = "qcom,ipc_router_smd_xprt";
			qcom,ch-name = "IPCRTR";
			qcom,xprt-remote = "wcnss";
			qcom,xprt-linkid = <0x01>;
			qcom,xprt-version = <0x01>;
			qcom,fragmented-data;
		};

		qcom,gdsc@184c018 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus";
			reg = <0x184c018 0x04>;
			status = "okay";
			clock-names = "bus_clk", "core_clk";
			clocks = <0x16 0xcdf4c8f6 0x16 0xf76a02bb>;
			linux,phandle = <0x7f>;
			phandle = <0x7f>;
		};

		qcom,gdsc@184d078 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_mdss";
			reg = <0x184d078 0x04>;
			status = "okay";
			clock-names = "core_clk", "bus_clk";
			clocks = <0x16 0x22f3521f 0x16 0x668f51de>;
			linux,phandle = <0x82>;
			phandle = <0x82>;
		};

		qcom,gdsc@185701c {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_jpeg";
			reg = <0x185701c 0x04>;
			status = "disabled";
		};

		qcom,gdsc@1858034 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_vfe";
			reg = <0x1858034 0x04>;
			status = "okay";
			clock-names = "core_clk", "bus_clk", "csi_clk";
			clocks = <0x16 0xaaa3cd97 0x16 0x77fe2384 0x16 0xcc73453c>;
		};

		qcom,gdsc@185806c {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_vfe1";
			reg = <0x185806c 0x04>;
			status = "disabled";
		};

		qcom,gdsc@1858078 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_cpp";
			reg = <0x1858078 0x04>;
			status = "disabled";
		};

		qcom,gdsc@185901c {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_oxili_gx";
			reg = <0x185901c 0x04>;
			status = "okay";
			clock-names = "core_clk";
			clocks = <0x16 0x49a51fd9>;
			linux,phandle = <0x19>;
			phandle = <0x19>;
		};

		qcom,gdsc@184c028 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus_core0";
			reg = <0x184c028 0x04>;
			status = "okay";
			qcom,support-hw-trigger;
			clock-names = "core0_clk";
			clocks = <0x16 0x83a7f549>;
			linux,phandle = <0x80>;
			phandle = <0x80>;
		};

		qcom,gdsc@184c030 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus_core1";
			reg = <0x184c030 0x04>;
			status = "disabled";
		};

		qcom,gdsc@185904c {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_oxili_cx";
			reg = <0x185904c 0x04>;
			status = "disabled";
		};

		qcom,gdsc@183f078 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_usb30";
			reg = <0x183f078 0x04>;
			status = "disabled";
		};

		arm,smmu-kgsl@1f00000 {
			status = "ok";
			compatible = "qcom,qsmmu-v500";
			reg = <0x1f00000 0x10000 0x1ef2000 0x20>;
			reg-names = "base", "tcu-base";
			#iommu-cells = <0x01>;
			qcom,tz-device-id = "GPU";
			qcom,skip-init;
			qcom,dynamic;
			qcom,use-3-lvl-tables;
			#global-interrupts = <0x00>;
			#size-cells = <0x01>;
			#address-cells = <0x01>;
			ranges;
			interrupts = <0x00 0xf0 0x04 0x00 0xf1 0x04 0x00 0xf2 0x04 0x00 0xf5 0x04>;
			clocks = <0x16 0x75eaefa5 0x16 0x59505e55>;
			clock-names = "iface_clk", "core_clk";
			linux,phandle = <0x17>;
			phandle = <0x17>;
		};

		kgsl_iommu_test_device0 {
			status = "disabled";
			compatible = "iommu-debug-test";
			iommus = <0x17 0x00>;
		};

		qcom,iommu@1e00000 {
			compatible = "qcom,qsmmu-v500";
			reg = <0x1e00000 0x40000 0x1ef2000 0x20>;
			reg-names = "base", "tcu-base";
			#iommu-cells = <0x02>;
			qcom,tz-device-id = "APPS";
			qcom,skip-init;
			qcom,enable-static-cb;
			qcom,use-3-lvl-tables;
			qcom,disable-atos;
			#global-interrupts = <0x00>;
			#size-cells = <0x01>;
			#address-cells = <0x01>;
			ranges;
			interrupts = <0x00 0x65 0x04 0x00 0x66 0x04 0x00 0x67 0x04 0x00 0x68 0x04 0x00 0x69 0x04 0x00 0x6a 0x04 0x00 0x6d 0x04 0x00 0x6e 0x04 0x00 0x6f 0x04 0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04 0x00 0x78 0x04 0x00 0x79 0x04 0x00 0x7a 0x04 0x00 0xdf 0x04 0x00 0xe0 0x04 0x00 0xe1 0x04 0x00 0xe4 0x04 0x00 0xe5 0x04 0x00 0xe6 0x04 0x00 0xe7 0x04 0x00 0xe8 0x04 0x00 0xe9 0x04 0x00 0x96 0x04 0x00 0x97 0x04 0x00 0x98 0x04>;
			clocks = <0x16 0x75eaefa5 0x16 0xaf56a329>;
			clock-names = "iface_clk", "core_clk";
			linux,phandle = <0x81>;
			phandle = <0x81>;
		};

		qcom,kgsl-busmon {
			label = "kgsl-busmon";
			compatible = "qcom,kgsl-busmon";
		};

		qcom,gpubw {
			compatible = "qcom,devbw";
			governor = "bw_vbif";
			qcom,src-dst-ports = <0x1a 0x200>;
			qcom,bw-tbl = <0x00 0x16e 0x2dc 0x5b8 0xb71>;
			linux,phandle = <0x18>;
			phandle = <0x18>;
		};

		qcom,kgsl-3d0@01c00000 {
			label = "kgsl-3d0";
			compatible = "qcom,kgsl-3d0", "qcom,kgsl-3d";
			status = "ok";
			reg = <0x1c00000 0x10000 0x1c10000 0x10000 0x5c000 0x204>;
			reg-names = "kgsl_3d0_reg_memory", "kgsl_3d0_shader_memory", "qfprom_memory";
			interrupts = <0x00 0x21 0x00>;
			interrupt-names = "kgsl_3d0_irq";
			qcom,id = <0x00>;
			qcom,chipid = <0x3000400>;
			qcom,initial-pwrlevel = <0x01>;
			qcom,idle-timeout = <0x50>;
			qcom,strtstp-sleepwake;
			qcom,gpu-disable-fuse = <0x44 0x01 0x1b>;
			qcom,clk-map = <0x56>;
			clocks = <0x16 0x49a51fd9 0x16 0xd15c8a00 0x16 0x3edd69ad 0x16 0x19922503 0x16 0xb432168e>;
			clock-names = "core_clk", "iface_clk", "mem_iface_clk", "alt_mem_iface_clk", "gtcu_iface_clk";
			qcom,gpubw-dev = <0x18>;
			qcom,bus-control;
			qcom,msm-bus,name = "grp3d";
			qcom,msm-bus,num-cases = <0x03>;
			qcom,msm-bus,num-paths = <0x01>;
			qcom,msm-bus,vectors-KBps = <0x1a 0x200 0x00 0x00 0x1a 0x200 0x00 0x177000 0x1a 0x200 0x00 0x2ed830>;
			vdd-supply = <0x19>;
			qcom,pm-qos-active-latency = <0x2bd>;
			qcom,pm-qos-wakeup-latency = <0x2bd>;
			#cooling-cells = <0x02>;
			qcom,disable-wake-on-touch;
			linux,phandle = <0x95>;
			phandle = <0x95>;

			qcom,gpu-pwrlevels {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,gpu-pwrlevels";

				qcom,gpu-pwrlevel@0 {
					reg = <0x00>;
					qcom,gpu-freq = <0xbebc200>;
					qcom,bus-freq = <0x01>;
					qcom,bus-min = <0x01>;
					qcom,bus-max = <0x01>;
				};

				qcom,gpu-pwrlevel@1 {
					reg = <0x01>;
					qcom,gpu-freq = <0x124f800>;
					qcom,bus-freq = <0x00>;
					qcom,bus-min = <0x00>;
					qcom,bus-max = <0x00>;
				};
			};
		};

		qcom,kgsl-iommu@1f00000 {
			compatible = "qcom,kgsl-smmu-v2";
			reg = <0x1f00000 0x10000>;
			qcom,protect = <0xa000 0x1000>;
			clocks = <0x16 0x75eaefa5 0x16 0x59505e55 0x16 0xb432168e 0x16 0x18bb9a90>;
			clock-names = "scfg_clk", "gtcu_clk", "gtcu_iface_clk", "gtbu_clk";
			qcom,retention;

			gfx3d_user {
				compatible = "qcom,smmu-kgsl-cb";
				iommus = <0x17 0x00>;
				qcom,gpu-offset = <0xa000>;
			};
		};

		tmc@826000 {
			compatible = "arm,primecell";
			arm,primecell-periphid = <0x3b961>;
			reg = <0x826000 0x1000 0x884000 0x15000>;
			reg-names = "tmc-base", "bam-base";
			interrupts = <0x00 0xa6 0x00>;
			interrupt-names = "byte-cntr-irq";
			arm,buffer-size = <0x100000>;
			arm,sg-enable;
			coresight-name = "coresight-tmc-etr";
			coresight-ctis = <0x1a 0x1b>;
			coresight-csr = <0x1c>;
			clocks = <0x1d 0x1492202a 0x1d 0xdd121669>;
			clock-names = "apb_pclk";

			port {

				endpoint {
					slave-mode;
					remote-endpoint = <0x1e>;
					linux,phandle = <0x21>;
					phandle = <0x21>;
				};
			};
		};

		tmc@825000 {
			compatible = "arm,primecell";
			arm,primecell-periphid = <0x3b961>;
			reg = <0x825000 0x1000>;
			reg-names = "tmc-base";
			coresight-name = "coresight-tmc-etf";
			arm,default-sink;
			coresight-ctis = <0x1a 0x1b>;
			coresight-csr = <0x1c>;
			clocks = <0x1d 0x1492202a 0x1d 0xdd121669>;
			clock-names = "apb_pclk";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {

					endpoint {
						remote-endpoint = <0x1f>;
						linux,phandle = <0x22>;
						phandle = <0x22>;
					};
				};

				port@1 {
					reg = <0x00>;

					endpoint {
						slave-mode;
						remote-endpoint = <0x20>;
						linux,phandle = <0x23>;
						phandle = <0x23>;
					};
				};
			};
		};

		replicator@824000 {
			compatible = "arm,primecell";
			arm,primecell-periphid = <0x3b909>;
			reg = <0x824000 0x1000>;
			reg-names = "replicator-base";
			coresight-name = "coresight-replicator";
