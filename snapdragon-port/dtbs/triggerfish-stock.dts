			qcom,spdm-interval = <0x64>;
			qcom,ports = <0x0b>;
			qcom,alpha-up = <0x08>;
			qcom,alpha-down = <0x0f>;
			qcom,bucket-size = <0x08>;
			qcom,pl-freqs = <0x173eed80 0x18701a80>;
			qcom,reject-rate = <0x1388 0x1388 0x1388 0x1388 0x1388 0x1388>;
			qcom,response-time-us = <0x1388 0x1388 0x1388 0x1388 0xbb8 0xbb8>;
			qcom,cci-response-time-us = <0x1388 0x1388 0x1388 0x1388 0x3e8 0x3e8>;
