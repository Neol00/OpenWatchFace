			qcom,bus-freq-table {

				qcom,profile-enc {
					qcom,codec-mask = <0x55555555>;
					qcom,load-busfreq-tbl = <0x3bc40 0xcd528 0x34bc0 0xb4aa0 0x2f760 0xa6040 0x23280 0x79180 0x1a5e0 0x5a550 0x17bb0 0x53020 0xbdd8 0x29810 0x11940 0x3c8c0 0x8ca0 0x1e460 0x4650 0x11170 0x2328 0x88b8 0x00 0x00>;
