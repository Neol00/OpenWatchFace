		tsens@4a8000 {
			compatible = "qcom,msm8909-tsens";
			reg = <0x4a8000 0x1000 0x4a9000 0x1000 0x5c000 0x1000>;
			reg-names = "tsens_srot_physical", "tsens_tm_physical", "tsens_eeprom_physical";
			interrupts = <0x00 0xb8 0x00>;
