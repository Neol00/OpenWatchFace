		};

		qcom,vidc@1d00000 {
			compatible = "qcom,msm-vidc";
			reg = <0x1d00000 0xff000>;
			interrupts = <0x00 0x2c 0x00>;
			qcom,hfi-version = "3xx";
			venus-supply = <0x7f>;
			venus-core0-supply = <0x80>;
			clocks = <0x16 0xf76a02bb 0x16 0x83a7f549 0x16 0x8d778c6 0x16 0xcdf4c8f6>;
			clock-names = "core_clk", "core0_clk", "iface_clk", "bus_clk";
			qcom,clock-configs = <0x01 0x00 0x00 0x00>;
			qcom,sw-power-collapse;
			qcom,slave-side-cp;
			qcom,hfi = "venus";
			qcom,reg-presets = <0xe0020 0x5555556 0xe0024 0x5555556 0x80124 0x03>;
			qcom,qdss-presets = <0x826000 0x1000 0x827000 0x1000 0x822000 0x1000 0x803000 0x1000 0x9180000 0x1000 0x9181000 0x1000>;
			qcom,max-hw-load = <0x3bc40>;
			qcom,firmware-name = "venus";
			qcom,allowed-clock-rates = <0x124f8000 0xfe50fb0 0x7f27450>;

			qcom,clock-freq-tbl {

				qcom,profile-enc {
					qcom,codec-mask = <0x55555555>;
					qcom,cycles-per-mb = <0x90c>;
					qcom,low-power-mode-factor = <0x8000>;
				};

				qcom,profile-dec {
					qcom,codec-mask = <0xf3ffffff>;
					qcom,cycles-per-mb = <0x314>;
				};

				qcom,profile-hevcdec {
					qcom,codec-mask = <0xc000000>;
					qcom,cycles-per-mb = <0x3f7>;
				};
			};

			non_secure_cb {
				compatible = "qcom,msm-vidc,context-bank";
				label = "venus_ns";
				iommus = <0x81 0x800 0x00 0x81 0x807 0x00 0x81 0x808 0x27 0x81 0x811 0x00>;
				buffer-types = <0xfff>;
				virtual-addr-pool = <0x5dc00000 0x8f000000>;
			};

			secure_bitstream_cb {
				compatible = "qcom,msm-vidc,context-bank";
				label = "venus_sec_bitstream";
				iommus = <0x81 0x90c 0x20>;
				buffer-types = <0x241>;
				virtual-addr-pool = <0x4b000000 0x12c00000>;
				qcom,secure-context-bank;
			};

			secure_pixel_cb {
				compatible = "qcom,msm-vidc,context-bank";
				label = "venus_sec_pixel";
				iommus = <0x81 0x900 0x00 0x81 0x909 0x20 0x81 0x90a 0x00 0x81 0x90b 0x20 0x81 0x90e 0x00>;
				buffer-types = <0x106>;
				virtual-addr-pool = <0x25800000 0x25800000>;
				qcom,secure-context-bank;
			};

			secure_non_pixel_cb {
				compatible = "qcom,msm-vidc,context-bank";
				label = "venus_sec_non_pixel";
				iommus = <0x81 0x9c0 0x00 0x81 0x907 0x00 0x81 0x908 0x20 0x81 0x90d 0x20 0x81 0x90f 0x00>;
				buffer-types = <0x480>;
				virtual-addr-pool = <0x1000000 0x24800000>;
				qcom,secure-context-bank;
			};

			venus_bus_ddr {
				compatible = "qcom,msm-vidc,bus";
