diff --git a/src/peripherals/display/tdd_display/src/qspi/tdd_display_qspi.c b/src/peripherals/display/tdd_display/src/qspi/tdd_display_qspi.c
index 38b163c0..7337e4cd 100755
--- a/src/peripherals/display/tdd_display/src/qspi/tdd_display_qspi.c
+++ b/src/peripherals/display/tdd_display/src/qspi/tdd_display_qspi.c
@@ -153,7 +153,6 @@ static void __disp_qspi_set_window(DISP_QSPI_BASE_CFG_T *p_cfg, uint16_t x_start
                             uint16_t x_end, uint16_t y_end)
 {
     uint8_t lcd_data[4];
-    static uint16_t x1=0, x2=0, y1=0, y2=0;
 
     if (NULL == p_cfg) {
         return;
@@ -164,25 +163,27 @@ static void __disp_qspi_set_window(DISP_QSPI_BASE_CFG_T *p_cfg, uint16_t x_start
     y_start += p_cfg->y_offset;
     y_end   += p_cfg->y_offset;
 
-    if(x1 != x_start || x2 != x_end) {
-        lcd_data[0] = (x_start >> 8) & 0xFF;
-        lcd_data[1] = (x_start & 0xFF);
-        lcd_data[2] = (x_end >> 8) & 0xFF;
-        lcd_data[3] = (x_end & 0xFF);
-        __disp_qspi_send_cmd(p_cfg, p_cfg->cmd_caset, lcd_data, sizeof(lcd_data));
-        x1 = x_start;
-        x2 = x_end;
-    }
-
-    if(y1 != y_start || y2 != y_end) {
-        lcd_data[0] = (y_start >> 8) & 0xFF;
-        lcd_data[1] = (y_start & 0xFF);
-        lcd_data[2] = (y_end >> 8) & 0xFF;
-        lcd_data[3] = (y_end & 0xFF);
-        __disp_qspi_send_cmd(p_cfg, p_cfg->cmd_raset, lcd_data, sizeof(lcd_data));
-        y1 = y_start;
-        y2 = y_end;
-    }
+    /* OWF: ALWAYS send CASET/RASET — do NOT cache the last window and skip.
+     * The original code kept static x1/x2/y1/y2 and skipped the command when the
+     * new window matched the cached one. With per-area dirty-rect pushes that share
+     * a window, a transient/aborted transfer can leave the panel's GRAM row/column
+     * address counter out of sync with what the cache believes; the skipped
+     * CASET/RASET then never re-anchors it, so subsequent pushes shear (an italic/
+     * curved warp on buttons, the brightness slider, the clock font) until some
+     * later DIFFERING window happens to resync it. Re-sending the window every push
+     * (two 4-byte commands) re-anchors the panel each time and costs nothing
+     * measurable. */
+    lcd_data[0] = (x_start >> 8) & 0xFF;
+    lcd_data[1] = (x_start & 0xFF);
+    lcd_data[2] = (x_end >> 8) & 0xFF;
+    lcd_data[3] = (x_end & 0xFF);
+    __disp_qspi_send_cmd(p_cfg, p_cfg->cmd_caset, lcd_data, sizeof(lcd_data));
+
+    lcd_data[0] = (y_start >> 8) & 0xFF;
+    lcd_data[1] = (y_start & 0xFF);
+    lcd_data[2] = (y_end >> 8) & 0xFF;
+    lcd_data[3] = (y_end & 0xFF);
+    __disp_qspi_send_cmd(p_cfg, p_cfg->cmd_raset, lcd_data, sizeof(lcd_data));
 }
 
 static OPERATE_RET __disp_qspi_send_frame(DISP_QSPI_BASE_CFG_T *p_cfg, TDL_DISP_FRAME_BUFF_T *p_fb)
